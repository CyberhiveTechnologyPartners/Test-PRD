  Rel(composer, posture, "Requests grade trend")
  Rel(composer, kpi, "Requests five tiles")
  Rel(composer, attention, "Requests open items")
  Rel(composer, threatline, "Requests level explanation")
  Rel(composer, summary, "Requests plain-language summary")
