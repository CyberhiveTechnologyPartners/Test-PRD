C4Component
  title Component view - Home Aggregate API
  Container_Boundary(api, "Home Aggregate API") {
    Component(composer, "Home payload composer", "Handler", "Assembles one response")
    Component(posture, "Grade and trend builder", "Logic", "Current grade, four quarters, top action")
    Component(kpi, "KPI tile builder", "Logic", "Incidents, SLA, coverage, remediation, hours")
    Component(attention, "Needs-attention builder", "Logic", "Open items with owner and due date")
    Component(threatline, "ThreatCon line provider", "Logic", "Level plus fixed explanation")
