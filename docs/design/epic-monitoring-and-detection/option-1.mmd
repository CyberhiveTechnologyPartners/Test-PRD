C4Container
  title Containers for the Member IT Lead monitoring screen
  Person(itLead, "Member IT Lead", "Selects facility and period")
  Container_Boundary(prd, "Test-PRD prototype") {
    Container(shell, "App shell", "React", "Header, sidebar, outlet")
    Container(routes, "Cyber route group", "React", "Hand-rolled /cyber routing")
    Container(monitor, "Monitoring screen", "React", "Funnel, tickets, SLA, logs, coverage")
    Container(selectors, "Monitoring selectors", "TypeScript", "Pure period scoped metrics")
