erDiagram
  JOURNAL_ENTRY ||--o{ ENTRY_LINE : contains
  JOURNAL_ENTRY ||--o{ ENTRY_HISTORY : has
  USER ||--o{ USER_ROLE : holds
  JOURNAL_ENTRY {
    string id PK
    string status
    string createdBy
    datetime createdAt
    datetime updatedAt
  }
  ENTRY_LINE {
    string id PK
    string entryId FK
    string account
    decimal debit
    decimal credit
  }
  ENTRY_HISTORY {
    string id PK
    string entryId FK
    string action
    string actorId
    string actorRole
    datetime occurredAt
    string reason
  }
  USER {
    string id PK
    string name
  }
  USER_ROLE {
    string userId FK
    string role
  }
